#!/bin/bash
# driver-mgt - Bash wrapper to ensure venv activation
# This script automatically activates the virtual environment before running the Python application

set -e

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Determine if we're in development mode or installed mode
if [ -f "$SCRIPT_DIR/driver-mgt.py" ] && [ -d "$SCRIPT_DIR/src" ]; then
    # Development/repo mode
    INSTALL_DIR="$SCRIPT_DIR"
    PYTHON_SCRIPT="$SCRIPT_DIR/driver-mgt.py"
else
    # Installed mode
    INSTALL_DIR="/opt/driver-mgt"
    PYTHON_SCRIPT="/opt/driver-mgt/driver-mgt.py"
fi

VENV_DIR="$INSTALL_DIR/venv"
VENV_PYTHON="$VENV_DIR/bin/python"

# Check if venv exists
if [ ! -d "$VENV_DIR" ]; then
    echo "Error: Virtual environment not found at: $VENV_DIR"
    echo ""
    echo "Please run the installation script first:"
    echo "  sudo bash install.sh"
    echo ""
    echo "Or if you're in development mode, create it manually:"
    echo "  python3 -m venv $VENV_DIR"
    echo "  $VENV_DIR/bin/pip install -r $INSTALL_DIR/requirements.txt"
    echo ""
    echo "To check system dependencies, run:"
    echo "  bash check-system-deps.sh"
    echo ""
    exit 1
fi

# Check if Python exists in venv
if [ ! -f "$VENV_PYTHON" ]; then
    echo "Error: Python not found in virtual environment"
    echo "Expected: $VENV_PYTHON"
    echo ""
    echo "Try recreating the virtual environment:"
    echo "  rm -rf $VENV_DIR"
    echo "  python3 -m venv $VENV_DIR"
    echo "  $VENV_PYTHON -m pip install -r $INSTALL_DIR/requirements.txt"
    echo ""
    exit 1
fi

# Check if Python script exists
if [ ! -f "$PYTHON_SCRIPT" ]; then
    echo "Error: driver-mgt.py not found at: $PYTHON_SCRIPT"
    exit 1
fi

# Set environment variable to indicate we're running from wrapper
export DRIVER_MGT_VENV_ACTIVE="1"
export VIRTUAL_ENV="$VENV_DIR"

# Update PATH to include venv bin directory
export PATH="$VENV_DIR/bin:$PATH"

# Quick dependency check (optional, but helpful)
echo -n "Checking Python dependencies... "
MISSING_DEPS=()

# Check each dependency individually for better error messages
for dep_import in "PyQt6:PyQt6" "psutil:psutil" "requests:requests" "yaml:pyyaml"; do
    IFS=':' read -r import_name pkg_name <<< "$dep_import"
    if ! "$VENV_PYTHON" -c "import $import_name" 2>/dev/null; then
        MISSING_DEPS+=("$pkg_name")
    fi
done

if [ ${#MISSING_DEPS[@]} -gt 0 ]; then
    echo "missing: ${MISSING_DEPS[*]}"
    echo ""
    echo "Attempting to install/repair dependencies..."
    
    if "$VENV_DIR/bin/pip" install -r "$INSTALL_DIR/requirements.txt"; then
        echo ""
        echo "✓ Dependencies installed successfully"
        echo ""
    else
        echo ""
        echo "✗ Error: Failed to install Python dependencies"
        echo ""
        echo "Missing dependencies: ${MISSING_DEPS[*]}"
        echo ""
        echo "This may be due to missing system libraries."
        echo "Run the system dependency checker:"
        echo "  bash check-system-deps.sh"
        echo ""
        echo "Or reinstall with:"
        echo "  sudo bash install.sh"
        echo ""
        exit 1
    fi
else
    echo "OK"
fi

# Execute the Python script with the venv Python interpreter
# Pass all arguments to the Python script
exec "$VENV_PYTHON" "$PYTHON_SCRIPT" "$@"
